# Dependencies
backend/.venv/
backend/.venv.*/
backend/node_modules/
frontend/node_modules/
electron/node_modules/
frontend/.next/
frontend/.next-build/
frontend/.next-dev-*/
frontend/out/

# Environment & secrets
backend/.env
backend/config.json
frontend/.env
skills/**/.env
!backend/.env.example
!backend/config.json.example
!frontend/.env.example
!skills/**/.env.example

# Runtime data
backend/sessions/
backend/memory/
backend/logs/
backend/archive/
backend/storage/
backend/workspace/
backend/output/

# Legacy task/reminder files (should not be in backend root)
backend/tasks.json
backend/task_reminders.log
backend/reminder_analysis.json

# Static system prompt files (tracked)
!backend/prompts/
backend/prompts/*
!backend/prompts/AGENTS.md
!backend/prompts/SOUL.md
!backend/prompts/IDENTITY.md
!backend/prompts/USER.md
!backend/prompts/system.md
!backend/prompts/deepagents/
!backend/prompts/deepagents/*.md
__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Local dev tooling
.codex-tmp/
.playwright-cli/
iterm2_workspace.iterm2arrangement

# Private design notes and project documentation
/docs/

# Logs
*.log

# Build outputs
dist/
build/
dist-electron/
*.egg-info/
frontend/tsconfig.tsbuildinfo

# The Worker CLI is installed directly from this repository, so its checked-in
# dependency-free runtime is part of the package rather than a disposable build.
!packages/puddingclaw-cli/dist/
!packages/puddingclaw-cli/dist/**

# Docker volumes (if any)
volumes/
data/

# Generated design artifacts
designs/

# SkillHub runtime lock
backend/skills/.skills_store_lock.json

# Feishu (lark-*) skills installed via managed skill plans
backend/skills/lark-*/

.pytest_cache
notebooks/.env
notebooks/
