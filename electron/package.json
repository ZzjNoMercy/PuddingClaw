{
  "name": "puddingclaw-electron",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "../scripts/start-electron-dev.sh",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:dmg": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "com.puddingclaw.app",
    "productName": "PuddingClaw",
    "forceCodeSigning": true,
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/icon.png",
      "managers/**/*",
      "!node_modules/electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/.next-build/standalone",
        "to": "frontend/.next-build/standalone",
        "filter": ["**/*", "!**/.env", "!**/.env.*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "pyproject.toml",
          "uv.lock",
          "app.py",
          "capabilities.py",
          "config.py",
          "provider_registry.py",
          "config.json",
          "higress_config_reader.py",
          "logging.yaml",
          ".env.example",
          "api/**/*",
          "graph/**/*",
          "knowledge/**/*",
          "llm/**/*",
          "mcp_clients/**/*",
          "memory/**/*",
          "prompts/**/*",
          "sessions/**/*",
          "skills/**/*",
          "storage/**/*",
          "tools/**/*",
          "utils/**/*",
          "workspace/**/*",
          "data/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../README.md",
        "to": "README.md"
      },
      {
        "from": "../docker-compose.infra.yml",
        "to": "docker-compose.infra.yml"
      },
      {
        "from": "../data/higress",
        "to": "data/higress",
        "filter": ["**/*"]
      },
      {
        "from": "../packages/puddingclaw-deploy-cli",
        "to": "cli",
        "filter": [
          "package.json",
          "worker.manifest.json",
          "src/**/*",
          "runtime-bundle/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "signIgnore": [
        "/Contents/Resources/backend/",
        "/Contents/Resources/cli/",
        "/Contents/Resources/frontend/"
      ],
      "notarize": true
    },
    "asar": true,
    "asarUnpack": ["managers/**/*.js"]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  }
}
