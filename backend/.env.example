# ============================================
# PuddingClaw 后端环境变量配置
# ============================================

# DeepSeek API 配置（主要 LLM）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API 配置（用于 Embedding 和备用 LLM）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# 服务器配置
HOST=0.0.0.0
PORT=8888

# Docker Compose PostgreSQL（docker compose --env-file backend/.env ...）
POSTGRES_DB=puddingclaw
POSTGRES_USER=puddingclaw
POSTGRES_PASSWORD=change-me-before-shared-deployment
POSTGRES_PORT=5432

# Worker CLI 检测与安装策略：auto 自动安装，prompt 在交互式启动时询问，never 只检测不安装。
# 当前源码开发环境不设置时默认 auto；开源/生产示例使用 prompt，避免启动时静默修改全局 npm 环境。
PUDDINGCLAW_CLI_INSTALL_POLICY=prompt
# 可选：覆盖本地 CLI 包目录；默认是仓库根目录 packages/puddingclaw-deploy-cli。
# PUDDINGCLAW_CLI_PACKAGE_DIR=/path/to/PuddingClaw/packages/puddingclaw-deploy-cli
# PUDDINGCLAW_CLI_INSTALL_TIMEOUT_S=120

# 搜索引擎配置
TAVILY_API_KEY=your_tavily_api_key_here

# 智慧芽 MCP 配置（专利检索）
# 从 https://open.zhihuiya.com/devportal/api-keys 获取 MCP Key，格式 sk-xxxxxxxxxxxx
ZHIHUIYA_MCP_API_KEY=your_zhihuiya_mcp_key_here

# 本地基础设施地址
# frontend/backend 在本机运行；Higress/Milvus 由 docker-compose.infra.yml 提供；
# PostgreSQL 支持两种方式：
#   1. PuddingClaw 内置：由 docker-compose.infra.yml 的 postgres service 提供。
#      默认 database/username/password 都是 puddingclaw，端口默认 5432。
#   2. 本机 PostgreSQL：scripts/start-local-infra.sh 会检测 5432 是否已有本机 PostgreSQL；
#      若存在，会自动写入 backend/config.json，不需要手写连接串。
#      只有 PUDDINGCLAW_DATABASE_URL 会强制覆盖设置页，日常不建议配置。
# MinerU 在本机运行，不进入 Docker。
# PUDDINGCLAW_DATABASE_URL=postgresql+asyncpg://puddingclaw:puddingclaw@127.0.0.1:5432/puddingclaw
MILVUS_URL=http://localhost:19530
MILVUS_URI=http://localhost:19530

# 知识库物理目录
# 常规使用建议在 Settings -> 知识库 中写入 config.json 的 knowledge.root_dir；
# 不设置时默认使用 backend/knowledge。
# 此环境变量仅作为 Docker/CI/临时覆盖；设置后会覆盖 config.json。
# DeepAgents /knowledge/、PDF/MinerU md、图片资产、glob/grep、LlamaIndex 索引都会使用该目录。
# PUDDINGCLAW_KNOWLEDGE_DIR=/Users/pet/Documents/PuddingClawKnowledge

# 图文混排 PDF / LlamaIndex 多模态索引
# 默认统一使用 DashScope Qwen-VL embedding 构建 MultiModalVectorStoreIndex；
# 如果未配置多模态 embedding / Milvus，向量发布会明确失败，不会静默退回文本 embedding。
# 常规配置建议写入 config.json 的 knowledge.multimodal_index / multimodal_embedding；
# 下面环境变量保留给 Docker/CI/临时覆盖。
PUDDINGCLAW_ENABLE_MULTIMODAL_INDEX=true
PUDDINGCLAW_MULTIMODAL_VECTOR_STORE=milvus
PUDDINGCLAW_MULTIMODAL_EMBED_MODEL=qwen2.5-vl-embedding
PUDDINGCLAW_MULTIMODAL_EMBED_DIM=1024
# qwen-vl embedding 是 DashScope 原生接口，不是 OpenAI-compatible /v1/embeddings。
# 如果你在 Higress 配了 native passthrough，可设置下面两个值；否则留空走 DashScope SDK direct。
# SDK direct 模式会按 config.json -> DASHSCOPE_API_KEY/EMBEDDING_API_KEY -> Higress qwen provider token 顺序取 key。
# PUDDINGCLAW_MULTIMODAL_EMBED_BASE_URL=http://localhost:8080
PUDDINGCLAW_MULTIMODAL_EMBED_ROUTE_PATH=/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
PUDDINGCLAW_MILVUS_TEXT_COLLECTION=puddingclaw_knowledge_text
PUDDINGCLAW_MILVUS_IMAGE_COLLECTION=puddingclaw_knowledge_image
# 可选：Higress 里已经配了相同 DashScope key 时，这里不用重复填写。
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 其他配置
HTTP_TIMEOUT_SECONDS=30
# 可选：为网页/稍后读抓取指定 HTTPS 出站代理。macOS 默认自动读取系统 HTTPS 代理；
# Docker、Linux 或需要覆盖系统设置时再配置。仅当目标域名解析为 Clash/sing-box Fake-IP 时使用，
# 普通公网地址仍走 SSRF 安全的 IP 固定直连路径。
# PUDDINGCLAW_HTTPS_PROXY=http://127.0.0.1:7890

# SWE-bench Coding Experiment 会在 Agent 生成 patch 后自动调用固定版本
# swebench==4.1.0 + Docker Harness 判卷。Docker Desktop/Engine 必须已启动；
# 首次运行会拉取或构建镜像，官方建议预留至少 120GB Docker 磁盘和 16GB 内存。
# ARM64 默认 namespace=none 并在本机构建镜像；x86_64 默认使用 swebench 预构建镜像。
# PUDDINGCLAW_SWEBENCH_NAMESPACE=swebench
# PUDDINGCLAW_SWEBENCH_MAX_WORKERS=1
# PUDDINGCLAW_SWEBENCH_TEST_TIMEOUT_SECONDS=1800
# PUDDINGCLAW_SWEBENCH_JOB_TIMEOUT_SECONDS=7200
# Candidate containers are network-disabled and default to 8 GiB / 4 CPUs / 1024 PIDs / 20 GiB writable layer.
# PUDDINGCLAW_SWEBENCH_CONTAINER_MEMORY=8g
# PUDDINGCLAW_SWEBENCH_CONTAINER_CPUS=4
# PUDDINGCLAW_SWEBENCH_CONTAINER_PIDS=1024
# PUDDINGCLAW_SWEBENCH_CONTAINER_DISK_GB=20
# Linux must use a dedicated rootless/VM Docker endpoint and acknowledge it:
# PUDDINGCLAW_SWEBENCH_ISOLATED_DOCKER=1
# Install the locked verifier once: cd backend && uv sync --extra evaluation

# LLM 输入日志默认只记录结构、长度和哈希；仅临时诊断时显式开启正文。
# LLM_INPUT_LOG_ENABLED=1
# LLM_INPUT_LOG_BODY_ENABLED=0
